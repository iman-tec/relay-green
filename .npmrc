# @stripe/react-stripe-js@6.x declares a peer dependency on
# @stripe/stripe-js >=9.3.1 <10.0.0 — a version range that doesn't
# exist yet (latest stable stripe-js is v5). The runtime is fine; the
# peer range is just wrong in their package.json. Skip the strict check
# so npm install doesn't fail in CI / Vercel.
legacy-peer-deps=true
