

# Relay.green local environment variables.
# Copy to .env and adjust as needed. Never commit the .env file.

# --- Database ---
# Local Postgres via docker-compose (see docker-compose.yml):
DATABASE_URL="postgresql://relay:relaylocaldev@localhost:5432/relay_green?schema=public"

# --- Supabase (auth + edge functions) ---
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://vdduelvjrzeczmakxgpn.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""  # server-only, never expose to client

# --- Auth (Phase 1; not used in Phase 0 demo auth) ---
# AUTH_SECRET=""
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# APPLE_OAUTH_CLIENT_ID=""

# --- GitHub OAuth ("Continue with GitHub" on /login) ---
# 1) Create a GitHub OAuth App → https://github.com/settings/developers
#      Authorization callback URL (HOSTED project):
#        https://vdduelvjrzeczmakxgpn.supabase.co/auth/v1/callback
# 2) HOSTED: paste Client ID + Secret in Supabase Dashboard →
#      Authentication → Providers → GitHub (toggle on). The app code already
#      calls signInWithOAuth("github"); no code change needed.
#    LOCAL: set these two + uncomment [auth.external.github] in
#      supabase/config.toml so `supabase start` enables it.
# GITHUB_CLIENT_ID=""
# GITHUB_SECRET=""

# --- Email (Resend) ---
# Used by:
#   1. Supabase Auth email OTP (configured in Supabase Dashboard → Auth → SMTP)
#   2. POST /api/contact — the public marketing contact endpoint sends
#      inquiries to CONTACT_INBOX_EMAIL via Resend when this key is set.
#      Without the key, leads are logged to the server console instead.
# RESEND_API_KEY=""
# OTP_FROM_EMAIL="team@relay.green"
# CONTACT_FROM_EMAIL="noreply@relay.green"   # From-address on contact emails
# CONTACT_INBOX_EMAIL="hello@relay.green"    # Destination for contact emails

# --- Phone OTP via Twilio Verify (Phase 1) ---
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_VERIFY_SERVICE_SID=""

# --- Stripe (Phase 4 real provider; mocked in Phase 0–3) ---
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Anthropic (Phase 1 mock; real Haiku 4.5 calls in Phase 4) ---
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# --- Zoom Video SDK ---
# Set to "true" to flip the room/engineer-session call buttons from the
# legacy "open Zoom in a new tab" Meeting-SDK flow to the in-window
# Video SDK <CallSurface> (see app/_components/call/). Defaults to off;
# the Meeting-SDK path keeps working until cutover.
# NEXT_PUBLIC_USE_VIDEO_SDK="false"
# Edge-function secrets (set via `supabase secrets set` — not read by Next):
# ZOOM_VIDEO_SDK_KEY=""
# ZOOM_VIDEO_SDK_SECRET=""
# ZOOM_VIDEO_API_KEY=""
# ZOOM_VIDEO_API_SECRET=""
# ZOOM_VIDEO_WEBHOOK_SECRET=""

# --- Brand config (single source of truth for customer-facing strings) ---
NEXT_PUBLIC_BRAND_NAME="Relay.green"
NEXT_PUBLIC_BRAND_DOMAIN="relay.green"
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL="support@relay.green"
NEXT_PUBLIC_BRAND_BILLING_EMAIL="billing@relay.green"
