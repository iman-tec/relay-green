# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# Unsigned installers staged for code-signing.
# Files live here until they're code-signed (Authenticode), then move
# back to /public/downloads/ and re-add to git in a follow-up commit.
# See LAUNCH.md §1.3.
/public/_unreleased-downloads/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (committed example excluded from ignore)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
# Supabase — never commit these
supabase/functions/.env
supabase/functions/.env.*
supabase/.temp
supabase/.branches

certificates

# Local QA artifacts (screenshots, lighthouse reports) — never commit.
/qa/

# Nested worktree-style checkout used during pre-launch redesign. Has its
# own node_modules and .next; must never be deployed.
/relay-green/

# Scratch dir used by Claude Code tools.
/.claude-tmp/

# Claude Code local runtime artifacts (preview server config, scheduled task
# lockfile). Project-tracked .claude/ files like agents/skills/settings can
# still be committed by explicit `git add` if needed.
/.claude/launch.json
/.claude/scheduled_tasks.lock